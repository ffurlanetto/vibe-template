{
  "//": "Which files the test gate treats as source, as test, or as neither. See docs/adr/ADR-002-test-gate.md. A file is classified in this order: tests, then exempt, then sources. Edit freely — a rising rate of Test-Exempt trailers usually means these globs need fixing, not that the rule is wrong.",
  "version": 1,
  "sources": [
    "src/**",
    "lib/**",
    "app/**",
    "apps/**",
    "internal/**",
    "cmd/**",
    "pkg/**",
    "packages/**",
    "modules/**",
    "terraform/**",
    "k8s/**",
    "*.py",
    "*.go",
    "*.ts",
    "*.tsx",
    "*.js",
    "*.jsx",
    "*.rb",
    "*.rs",
    "*.java",
    "*.kt",
    "*.cs",
    "*.dart",
    "*.tf"
  ],
  "tests": [
    "test/**",
    "tests/**",
    "spec/**",
    "specs/**",
    "__tests__/**",
    "src/test/**",
    "src/**/__tests__/**",
    "**/*_test.go",
    "**/*_test.py",
    "**/test_*.py",
    "**/conftest.py",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*Test.java",
    "**/*Tests.java",
    "**/*Tests.cs",
    "**/*_spec.rb",
    "**/*_test.rb",
    "**/*_test.exs",
    "**/*.feature",
    "**/*_test.dart",
    "**/*.bats"
  ],
  "exempt": [
    "**/*.md",
    "**/*.txt",
    "**/*.rst",
    "**/*.json",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.ini",
    "**/*.cfg",
    "**/*.properties",
    "**/*.env.example",
    "**/*.lock",
    "**/go.sum",
    "**/go.mod",
    "**/LICENSE*",
    "**/Makefile",
    "**/Dockerfile*",
    "**/.gitignore",
    "**/.editorconfig",
    "**/migrations/**",
    "**/generated/**",
    "**/*.gen.*",
    "**/*.pb.go",
    "docs/**",
    ".github/**",
    ".claude/**",
    ".opencode/**",
    "**/*.css",
    "**/*.scss",
    "**/*.html",
    "**/*.svg",
    "**/*.png",
    "**/*.ico"
  ],
  "//test_markers": "Unambiguous test declarations looked for in ADDED lines, so a language that keeps unit tests inside the source file (Rust's #[cfg(test)], a nested JUnit class) is not blocked by path globs alone. Keep this list narrow: a false positive silently disarms the gate.",
  "test_markers": [
    "#\\[cfg\\(test\\)\\]",
    "#\\[test\\]",
    "\\bfunc Test[A-Z_]",
    "@Test\\b",
    "\\bdef test_",
    "\\bclass Test[A-Z]",
    "\\bit\\(",
    "\\bdescribe\\("
  ]
}
