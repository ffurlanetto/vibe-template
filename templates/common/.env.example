# Copy to .env and fill in. NEVER commit .env — see AGENTS.md A5.
# Every variable the application reads must be listed here, with a safe default
# or an empty value. No real secret ever goes in this file.

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug
PORT=8080

# ── Dependencies ─────────────────────────────────────────────────────────────
# DATABASE_URL=
# REDIS_URL=

# ── Observability (AGENTS.md A8) ─────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=@@PROJECT@@
